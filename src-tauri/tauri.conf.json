{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Purser",
  "version": "0.4.1-beta.1",
  "identifier": "com.sschaefer.purser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "url": "index.html",
        "title": "Purser",
        "width": 600,
        "height": 520,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "quickadd",
        "url": "quickadd.html",
        "title": "Add todo",
        "width": 620,
        "height": 108,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "about",
        "url": "about.html",
        "title": "About Purser",
        "width": 340,
        "height": 230,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "help",
        "url": "help.html",
        "title": "Keyboard shortcuts",
        "width": 380,
        "height": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDOTlGM0NDOUEzRTk2QjIKUldTeWxqNmF6UE9aUEFWY2hyQjlIVStxZUNGY0RUdXphTmlwSStORm9ZL3pGMlkxSy9IcHMvQ2YK",
      "endpoints": ["https://github.com/hel800/purser/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "customLanguageFiles": {
          "English": "nsis/English.nsh"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
