{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the popup, quick-add, about, help and full list windows",
  "windows": ["popup", "quickadd", "about", "help", "list"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "sql:default",
    "sql:allow-execute",
    "opener:default"
  ]
}
